# --- Storage ---------------------------------------------------------------
# Leave empty to use the embedded PGlite database at ELEVATE_DATA_DIR (local mode).
# Set to a Postgres URL (with the pgvector extension available) for server/SaaS mode.
DATABASE_URL=
ELEVATE_DATA_DIR=.data

# 32+ char secret used to encrypt stored tokens/keys. Generated into .data/secret.key if empty.
ELEVATE_SECRET=

# --- GitHub ------------------------------------------------------------------
# Token used to read your repos and open issues/PRs. If empty, `gh auth token` is used
# for the account in GITHUB_USER, else the account pinned in Settings → GitHub, else gh's
# active account.
GITHUB_TOKEN=
GITHUB_USER=

# --- Models ------------------------------------------------------------------
# Model for the Copilot SDK runtime (uses your Copilot subscription). Leave empty for the
# Copilot default. Settings in the app override everything in this section (background
# model and chat default separately; each conversation can also pick its own).
ELEVATE_MODEL=
# Token whose Copilot seat pays for model calls. If empty: GITHUB_TOKEN, then
# `gh auth token --user` for GITHUB_USER or the account pinned in Settings (an error if gh
# has no login for that account, so usage never lands on another one), and only when no
# account is chosen, gh's active account and then the logged-in Copilot CLI user.
COPILOT_GITHUB_TOKEN=

# Bring-your-own-key providers (optional). When ELEVATE_PROVIDER is set, the Copilot
# runtime routes model calls to that provider instead of Copilot.
#   ELEVATE_PROVIDER=anthropic | openai | azure
ELEVATE_PROVIDER=
ELEVATE_PROVIDER_BASE_URL=
ELEVATE_PROVIDER_API_KEY=

# How many repo-focused searches (HN, arXiv, GitHub) each sweep runs, built from repo profiles.
ELEVATE_FOCUS_QUERIES=8

# Items published longer ago than this are skipped (feeds return their whole archive).
ELEVATE_MAX_ITEM_AGE_DAYS=60

# Offline demo: sample repos and sources, deterministic model, simulated swarms, no GitHub writes.
ELEVATE_DEMO=
# Use the deterministic fake model with real GitHub (tests).
ELEVATE_FAKE_LLM=

# Optional: OpenAI-compatible embeddings. Falls back to local feature-hashing embeddings.
OPENAI_API_KEY=

# --- Swarms ------------------------------------------------------------------
# CLI used by the local executor in git worktrees: copilot | claude | codex
ELEVATE_LOCAL_AGENT=copilot
# Model for the Copilot coding agent on cloud swarms (also settable in Settings). Empty = GitHub picks.
ELEVATE_CODING_AGENT_MODEL=
# Republish the coding agent's finished PR as you (one squashed commit, Copilot's PR closed).
# Default for the Settings switch; 0 keeps Copilot's PR as it is.
ELEVATE_PUBLISH_AS_ME=1

# --- Runtime -----------------------------------------------------------------
# Run the background worker inside the web process (local mode). Set to 0 when running
# apps/worker separately (needs DATABASE_URL: PGlite allows one process per data dir).
ELEVATE_EMBEDDED_WORKER=1
# Minutes between source sweeps and GitHub repo syncs. ELEVATE_SCHEDULER=off disables both.
# Each sync re-profiles any watched repo whose default branch has a new commit.
ELEVATE_SWEEP_MINUTES=15
ELEVATE_SYNC_MINUTES=2
ELEVATE_SCHEDULER=
# Matching: candidate repos per technique, and the minimum relevance to raise one.
ELEVATE_MATCH_TOP_K=6
ELEVATE_MIN_RELEVANCE=0.5

# --- Docker ------------------------------------------------------------------
# npm registry used by `docker compose build` (set a mirror if npmjs is unreachable).
NPM_REGISTRY=https://registry.npmjs.org/
